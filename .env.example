# Current architecture phase: external connections are deferred and disabled by default.
# No key or model subscription is needed for local archive workflows.
# Retained experimental adapters are only for a later explicitly requested phase:
# BANKING_STUDIO_EXTERNAL_CONNECTIONS=1

# Copy to .env.local. Keys stay on your machine. Never commit .env.local.
PORT=4173
# Optional later-phase local Claude CLI; not the default current workflow.
# Override only with your own installed executable/model; never put tokens here.
# CLAUDE_BIN=/opt/homebrew/bin/claude
# CLAUDE_MODEL=your-permitted-model
# BANKING_STUDIO_BRAND_DIR=/path/to/your/authorized/local/brand/fonts
# Optional OpenAI API connection for drafting and recorded audio transcription.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6.1-sol
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_VOICE_MODEL=gpt-realtime-2.1-mini
# Optional: retrieve entitled equity quotes into the local database.
ALPHA_VANTAGE_API_KEY=
# For public SEC refresh, identify your application/contact appropriately.
SEC_USER_AGENT=FinalFrontierFinanceDemo/0.1 (github.com/NeoDemos/investment-banking-reimagined)
